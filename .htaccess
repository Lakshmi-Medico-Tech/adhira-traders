# ==========================================================================
# ADHIRA FIRE WORKS & PYROTECH — cPanel Apache / LiteSpeed Configuration
# ==========================================================================

RewriteEngine On
RewriteBase /

# 1. Protect internal data and backup files from direct web access
<FilesMatch "^(config\.php|\.env|db\.json|.*\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

RewriteRule ^data/ - [F,L]
RewriteRule ^backups/ - [F,L]

# 2. Route all /api/* requests to api.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]

# 3. Ensure index.html is the default directory index
DirectoryIndex index.html

# 4. Prevent stale browser caching of billing scripts
<FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>
